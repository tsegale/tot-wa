# Copy this file to .env and fill in real values. Never commit .env.

# Resend API key (https://resend.com/api-keys). Required.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=info@tot-wa.com

# The "from" address Resend sends as. Must be on a domain verified in
# Resend (https://resend.com/domains) - tot-wa.com needs to be verified
# there before this will send. Format: "Display Name <address@domain>".
CONTACT_FROM_EMAIL="Tot Wa Website <website@tot-wa.com>"

# Local dev server port.
PORT=3000
